// Hash Table (open addressing)
// Maps keys to values by hashing the key to a bucket index.
// Collisions are handled by probing forward; when load gets high we resize.

import @arrays

const HashEntry struct {
    used bool
    deleted bool
    key i64
    value i64
}

const HashTable struct {
    entries [HashEntry]
    count i64
}

do ht_new() -> HashTable {
    mut entries [HashEntry] = {}
    mut i i64 = 0
    for i < 16 {
        arrays.append(entries, HashEntry{used: false, deleted: false, key: 0, value: 0})
        i += 1
    }
    return HashTable{entries: entries, count: 0}
}

do ht_hash(key i64, cap i64) -> i64 {
    mut k i64 = key
    if k < 0 { k = 0 - k }
    return k % cap
}

do ht_resize(&self HashTable) {
    mut old [HashEntry] = self.entries
    mut old_cap i64 = len(old)
    mut new_cap i64 = old_cap * 2

    mut entries [HashEntry] = {}
    mut i i64 = 0
    for i < new_cap {
        arrays.append(entries, HashEntry{used: false, deleted: false, key: 0, value: 0})
        i += 1
    }

    self.entries = entries
    self.count = 0

    i = 0
    for i < old_cap {
        if old[i].used && !old[i].deleted {
            ht_insert(self, old[i].key, old[i].value)
        }
        i += 1
    }
}

do ht_insert(&self HashTable, key i64, value i64) {
    mut cap i64 = len(self.entries)
    if (self.count + 1) * 10 >= cap * 7 {
        ht_resize(self)
        cap = len(self.entries)
    }

    mut idx i64 = ht_hash(key, cap)
    mut start i64 = idx
    mut first_deleted i64 = -1

    for true {
        if !self.entries[idx].used {
            mut target i64 = idx
            if first_deleted != -1 { target = first_deleted }
            self.entries[target] = HashEntry{used: true, deleted: false, key: key, value: value}
            self.count += 1
            return
        }

        if self.entries[idx].deleted {
            if first_deleted == -1 { first_deleted = idx }
        } or self.entries[idx].key == key {
            // keep first inserted value (matches original behavior)
            return
        }

        idx = (idx + 1) % cap
        if idx == start { break }
    }

    if first_deleted != -1 {
        self.entries[first_deleted] = HashEntry{used: true, deleted: false, key: key, value: value}
        self.count += 1
    }
}

do ht_search(self HashTable, key i64) -> (i64, bool) {
    mut cap i64 = len(self.entries)
    mut idx i64 = ht_hash(key, cap)
    mut start i64 = idx

    for true {
        if !self.entries[idx].used { return 0, false }
        if !self.entries[idx].deleted && self.entries[idx].key == key {
            return self.entries[idx].value, true
        }
        idx = (idx + 1) % cap
        if idx == start { break }
    }
    return 0, false
}

#test
do test_ht_insert_and_search() {
    mut ht = ht_new()
    ht_insert(ht, 1, 10)
    mut v, ok = ht_search(ht, 1)
    assert(ok && v == 10, "found")
}

#test
do test_ht_resize() {
    mut ht = ht_new()
    mut i i64 = 0
    for i < 100 { ht_insert(ht, i, i + 10); i += 1 }
    mut v, ok = ht_search(ht, 50)
    assert(ok && v == 60, "after resize")
}

#test
do test_ht_search_nonexistent() {
    mut ht = ht_new()
    ht_insert(ht, 1, 10)
    mut _, ok = ht_search(ht, 2)
    assert(!ok, "missing")
}

#test
do test_ht_multiple() {
    mut ht = ht_new()
    mut i i64 = 0
    for i < 10 { ht_insert(ht, i, i + 100); i += 1 }
    i = 0
    for i < 10 {
        mut v, ok = ht_search(ht, i)
        assert(ok && v == i + 100, "found")
        i += 1
    }
}

#test
do test_ht_no_overwrite() {
    mut ht = ht_new()
    ht_insert(ht, 1, 100)
    ht_insert(ht, 1, 200)
    mut v, ok = ht_search(ht, 1)
    assert(ok && v == 100, "keep first")
}

#test
do test_ht_empty() {
    mut ht = ht_new()
    mut _, ok = ht_search(ht, 1)
    assert(!ok, "empty")
}
