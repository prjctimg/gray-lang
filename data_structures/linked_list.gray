// Doubly linked list
// Each node points to next and previous nodes, so inserts/deletes at known
// positions can relink neighbors without shifting an array.

const DLNode struct {
    val i64
    next ^DLNode
    prev ^DLNode
}

const LinkedList struct {
    head ^DLNode
    tail ^DLNode
    length i64
}

do ll_new() -> LinkedList { return LinkedList{head: nil, tail: nil, length: 0} }

do ll_insert_at_head(&self LinkedList, val i64) {
    mut node ^DLNode = new(DLNode)
    node^.val = val
    node^.next = self.head
    node^.prev = nil

    if self.head != nil { self.head^.prev = node }
    otherwise { self.tail = node }

    self.head = node
    self.length += 1
}

do ll_insert_at_tail(&self LinkedList, val i64) {
    mut node ^DLNode = new(DLNode)
    node^.val = val
    node^.next = nil
    node^.prev = self.tail

    if self.tail != nil { self.tail^.next = node }
    otherwise { self.head = node }

    self.tail = node
    self.length += 1
}

do ll_get(self LinkedList, index i64) -> (i64, bool) {
    if index < 0 || index >= self.length { return 0, false }
    mut cur ^DLNode = self.head
    mut i i64 = 0
    for i < index {
        if cur == nil { return 0, false }
        cur = cur^.next
        i += 1
    }
    if cur == nil { return 0, false }
    return cur^.val, true
}

do ll_insert_at_ith(&self LinkedList, index i64, val i64) {
    if index < 0 || index > self.length { return }
    if index == 0 { ll_insert_at_head(self, val); return }
    if index == self.length { ll_insert_at_tail(self, val); return }

    mut cur ^DLNode = self.head
    mut i i64 = 0
    for i < index { cur = cur^.next; i += 1 }

    mut node ^DLNode = new(DLNode)
    node^.val = val
    node^.next = cur
    node^.prev = cur^.prev
    if cur^.prev != nil { cur^.prev^.next = node }
    cur^.prev = node
    self.length += 1
}

do ll_delete_head(&self LinkedList) -> (i64, bool) {
    if self.head == nil { return 0, false }
    mut node ^DLNode = self.head
    mut val i64 = node^.val
    self.head = node^.next
    if self.head != nil { self.head^.prev = nil } otherwise { self.tail = nil }
    self.length -= 1
    return val, true
}

do ll_delete_tail(&self LinkedList) -> (i64, bool) {
    if self.tail == nil { return 0, false }
    mut node ^DLNode = self.tail
    mut val i64 = node^.val
    self.tail = node^.prev
    if self.tail != nil { self.tail^.next = nil } otherwise { self.head = nil }
    self.length -= 1
    return val, true
}

do ll_delete_ith(&self LinkedList, index i64) -> (i64, bool) {
    if index < 0 || index >= self.length { return 0, false }
    if index == 0 { mut v, ok = ll_delete_head(self); return v, ok }
    if index == self.length - 1 { mut v, ok = ll_delete_tail(self); return v, ok }

    mut cur ^DLNode = self.head
    mut i i64 = 0
    for i < index { cur = cur^.next; i += 1 }

    mut val i64 = cur^.val
    if cur^.prev != nil { cur^.prev^.next = cur^.next }
    if cur^.next != nil { cur^.next^.prev = cur^.prev }
    self.length -= 1
    return val, true
}

#test
do test_ll_insert_at_tail() {
    mut list = ll_new()
    ll_insert_at_tail(list, 1)
    ll_insert_at_tail(list, 2)
    mut v, ok = ll_get(list, 1)
    assert(ok && v == 2, "tail")
}

#test
do test_ll_insert_at_head() {
    mut list = ll_new()
    ll_insert_at_head(list, 1)
    ll_insert_at_head(list, 2)
    mut v, ok = ll_get(list, 0)
    assert(ok && v == 2, "head")
}

#test
do test_ll_insert_at_ith() {
    mut list = ll_new()
    ll_insert_at_ith(list, 0, 0)
    ll_insert_at_ith(list, 1, 2)
    mut v, ok = ll_get(list, 1)
    assert(ok && v == 2, "ith tail")
}

#test
do test_ll_insert_at_ith_middle() {
    mut list = ll_new()
    ll_insert_at_ith(list, 0, 1)
    ll_insert_at_ith(list, 1, 2)
    ll_insert_at_ith(list, 1, 3)
    mut v1, ok1 = ll_get(list, 1)
    assert(ok1 && v1 == 3, "mid1")
    mut v2, ok2 = ll_get(list, 2)
    assert(ok2 && v2 == 2, "mid2")
}

#test
do test_ll_delete() {
    mut list = ll_new()
    ll_insert_at_tail(list, 1)
    ll_insert_at_tail(list, 2)
    ll_insert_at_tail(list, 3)
    mut v1, ok1 = ll_delete_head(list)
    assert(ok1 && v1 == 1, "del head")
    mut v2, ok2 = ll_delete_tail(list)
    assert(ok2 && v2 == 3, "del tail")
    assert(list.length == 1, "len 1")
}

#test
do test_ll_delete_ith() {
    mut list = ll_new()
    ll_insert_at_tail(list, 1)
    ll_insert_at_tail(list, 2)
    ll_insert_at_tail(list, 3)
    mut v, ok = ll_delete_ith(list, 1)
    assert(ok && v == 2, "del mid")
    mut v2, ok2 = ll_get(list, 1)
    assert(ok2 && v2 == 3, "after del")
}
